// The Worker as the tests run it: the real bindings, plus a source to back up and an empty
// database to restore into.
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "gateweave-backup-test",
	"main": "../src/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{ "binding": "CATALOG", "database_name": "catalog", "database_id": "catalog" },
		{ "binding": "SOURCE_DB", "database_name": "source", "database_id": "source" },
		{ "binding": "RESTORE_DB", "database_name": "restore", "database_id": "restore" }
	],
	"r2_buckets": [{ "binding": "VAULT", "bucket_name": "vault" }],
	// The stand-in app (test/app-worker.js): its Backup entrypoint, and a way to fill it.
	"services": [
		{ "binding": "APP", "service": "app", "entrypoint": "Backup" },
		{ "binding": "APP_SEED", "service": "app", "entrypoint": "Seed" }
	],
	"durable_objects": {
		"bindings": [{ "name": "RESTORE_TEST", "class_name": "RestoreTest" }]
	},
	"exports": {
		"RestoreTest": { "type": "durable-object", "storage": "sqlite" }
	},
	"workflows": [
		{
			"name": "gateweave-backup-test",
			"binding": "BACKUP",
			"class_name": "BackupWorkflow"
		}
	],
	"vars": {
		"SOURCES": [
			{ "name": "app", "kind": "d1", "binding": "SOURCE_DB" },
			{ "name": "broken", "kind": "d1", "binding": "VAULT" },
			{ "name": "objects", "kind": "do", "binding": "APP" }
		],
		"RETENTION": "1l 7d 4w 12m",
		"RESTORE_TEST_DAYS": "30",
		"JURISDICTION": "",
		"ALERT_FROM": ""
	}
}
