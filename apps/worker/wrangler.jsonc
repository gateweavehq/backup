// Gateweave Backup's Worker. It runs in the account whose data it backs up: see docs/deploy.md.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gateweave-backup",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	// It answers no requests, so it needs no public address.
	"workers_dev": false,
	"observability": { "enabled": true },
	// A step dumps, chunks and seals a whole database. Five minutes of CPU is the most a Workflow
	// step may have, and needs Workers Paid; Workflows on Free get 10 ms a step, which no backup fits.
	"limits": { "cpu_ms": 300000 },
	"d1_databases": [
		{
			// The catalog: runs, snapshots and locks. Not a source; it can be rebuilt from the bucket.
			"binding": "CATALOG",
			"database_name": "gateweave-backup",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			// Where the repositories live, one folder per source. Lock it: see docs/deploy.md.
			"binding": "VAULT",
			"bucket_name": "gateweave-backup"
		}
	],
	// Restore tests restore a snapshot into a Durable Object's SQLite and roll it back: one object
	// per source.
	"durable_objects": {
		"bindings": [{ "name": "RESTORE_TEST", "class_name": "RestoreTest" }]
	},
	"exports": {
		"RestoreTest": { "type": "durable-object", "storage": "sqlite" }
	},
	"workflows": [
		{
			"name": "gateweave-backup",
			"binding": "BACKUP",
			"class_name": "BackupWorkflow",
			// Every night at 03:17 UTC, away from the top of the hour when crons crowd.
			"schedules": ["17 3 * * *"],
			// One run at a time. A run also takes a lock per source, since scheduled instances may
			// start past this limit.
			"concurrency": { "limit": 1 }
		}
	],
	// The daily check, six hours after the nightly run: it alerts when a source's backup is late
	// or stuck, and sends again an alert that didn't go. It counts on backups running every night.
	"triggers": { "crons": ["17 9 * * *"] },
	// Email alerts need Email Service and a domain set up to send from (docs/deploy.md), then:
	// "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["backup@example.com"] }],
	"vars": {
		// What to back up. Each D1 source needs a binding of its own in `d1_databases`, an app's
		// Durable Objects a service binding to its Backup entrypoint in `services`, an R2 bucket a
		// binding in `r2_buckets`, and each a name that never changes: it is the repository's folder
		// in the bucket. For example:
		// [{ "name": "track", "kind": "d1", "binding": "TRACK_DB" },
		//  { "name": "track-workspaces", "kind": "do", "binding": "TRACK_APP" },
		//  { "name": "track-files", "kind": "r2", "binding": "TRACK_FILES" }]
		"SOURCES": [],
		// The newest snapshot, then one a day for 7 days, a week for 4 weeks, a month for 12 months.
		"RETENTION": "1l 7d 4w 12m",
		// Days between restore tests of a source. A run tests the snapshot it made when the source's
		// last passed test is this old, or it has none, so a failed test is tried again the next night.
		"RESTORE_TEST_DAYS": "30",
		// Where restore tests run: "eu" or "fedramp" to keep them in the bucket's jurisdiction, or
		// empty for anywhere.
		"JURISDICTION": "",
		// Who email alerts come from, as "Name <address>" or an address, on a domain Email Service
		// sends from. Where they go is the secret ALERT_TO. Empty sends none: see docs/deploy.md,
		// which also has alerts by webhook.
		"ALERT_FROM": "",
		// A copy outside Cloudflare, at an S3-compatible bucket elsewhere, as s3://<bucket>/<folder>.
		// Each run sends it what is new, and the copy keeps RETENTION on its own. Empty makes none.
		// The bucket's endpoint goes in COPY_ENDPOINT, the region it signs for in COPY_REGION, and a
		// key that may read, write and delete there in the secrets COPY_ACCESS_KEY_ID and
		// COPY_SECRET_ACCESS_KEY: see docs/deploy.md.
		"COPY_TO": "",
		"COPY_ENDPOINT": "",
		"COPY_REGION": ""
	},
	"secrets": {
		// The master key, from `pnpm keygen`. Keep a copy somewhere safe: without it, no backup
		// opens, and nobody can recover it.
		"required": ["BACKUP_KEY"]
	},
	"env": {
		// Gateweave Cloud's own backups: `npx wrangler deploy --env gateweave`. The bucket is in the EU
		// jurisdiction and locked for 21 days. Gateweave's privacy policy says recovery copies last up
		// to 30 days, so nothing is kept longer: 7 days and 3 weeks of snapshots, then at most a day
		// for the next prune, plus whatever the lock still holds, stays under it.
		"gateweave": {
			"name": "gateweave-backup",
			"d1_databases": [
				{
					"binding": "CATALOG",
					"database_name": "gateweave-backup",
					"database_id": "6588a2ad-1506-4ad8-ae41-4d6d1ab349e3",
					"migrations_dir": "migrations"
				},
				{
					"binding": "ID_DB",
					"database_name": "gateweave-id-eu",
					"database_id": "63428cb2-0195-4a16-9a78-bff66bd560c7"
				},
				{
					"binding": "TRACK_DB",
					"database_name": "gateweave-track-eu",
					"database_id": "bb35b197-846d-4e83-97b5-73a8f29e769e"
				},
				{
					"binding": "AGENTS_DB",
					"database_name": "gateweave-agents-eu",
					"database_id": "fd44c2ef-4ed9-4a19-9bf0-b4a055980096"
				},
				{
					"binding": "GUARD_DB",
					"database_name": "gateweave-guard-eu",
					"database_id": "621f0e88-a743-4aef-91cd-374acd9cf157"
				},
				{
					"binding": "MAIL_DB",
					"database_name": "gateweave-mail-eu",
					"database_id": "c0c5468c-f84b-45b8-a804-6412544febef"
				}
			],
			"r2_buckets": [
				{ "binding": "VAULT", "bucket_name": "gateweave-backup", "jurisdiction": "eu" },
				// Files attached in Track, a source: read, never written.
				{
					"binding": "TRACK_FILES",
					"bucket_name": "gateweave-track-files-eu",
					"jurisdiction": "eu"
				},
				// Mail's raw mail, a source: read, never written. Mail seals each object under its own
				// SECRETS_KEY, which this Worker never holds, so the objects are copied as they are,
				// still sealed.
				{ "binding": "MAIL_RAW", "bucket_name": "gateweave-mail-eu", "jurisdiction": "eu" }
			],
			// Track's workspaces, Agents' registries and conversations, and Mail's mailboxes with each
			// workspace's webhooks and audience, each in a Durable Object, through the apps' Backup
			// entrypoints. Mail's production Worker is its `cloud` environment, with a name of its own.
			"services": [
				{ "binding": "TRACK_APP", "service": "gateweave-track", "entrypoint": "Backup" },
				{ "binding": "AGENTS_APP", "service": "gateweave-agents", "entrypoint": "Backup" },
				{ "binding": "MAIL_APP", "service": "gateweave-mail-cloud", "entrypoint": "Backup" }
			],
			"durable_objects": {
				"bindings": [{ "name": "RESTORE_TEST", "class_name": "RestoreTest" }]
			},
			"workflows": [
				{
					"name": "gateweave-backup",
					"binding": "BACKUP",
					"class_name": "BackupWorkflow",
					"schedules": ["17 3 * * *"],
					"concurrency": { "limit": 1 }
				}
			],
			"triggers": { "crons": ["17 9 * * *"] },
			// Alerts go to the owner, whose address is the secret ALERT_TO.
			"send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["backup@gateweave.com"] }],
			"vars": {
				"SOURCES": [
					{ "name": "id", "kind": "d1", "binding": "ID_DB" },
					{ "name": "track", "kind": "d1", "binding": "TRACK_DB" },
					{ "name": "agents", "kind": "d1", "binding": "AGENTS_DB" },
					// Guard's tokens are sealed under its own SECRETS_KEY, so a restore needs that key too.
					{ "name": "guard", "kind": "d1", "binding": "GUARD_DB" },
					// Mail's provider keys in D1, its webhooks' secrets and its raw mail are sealed under
					// Mail's own SECRETS_KEY, so a restore needs that key too: docs/restore.md, "Mail".
					{ "name": "mail", "kind": "d1", "binding": "MAIL_DB" },
					{ "name": "track-workspaces", "kind": "do", "binding": "TRACK_APP" },
					{ "name": "agents-workspaces", "kind": "do", "binding": "AGENTS_APP" },
					{ "name": "mail-objects", "kind": "do", "binding": "MAIL_APP" },
					{ "name": "track-files", "kind": "r2", "binding": "TRACK_FILES" },
					{ "name": "mail-raw", "kind": "r2", "binding": "MAIL_RAW" }
				],
				"RETENTION": "1l 7d 3w",
				"RESTORE_TEST_DAYS": "30",
				"JURISDICTION": "eu",
				"ALERT_FROM": "Gateweave Backup <backup@gateweave.com>",
				// No copy outside Cloudflare yet: choosing its provider is the owner's call (WEB-35).
				"COPY_TO": "",
				"COPY_ENDPOINT": "",
				"COPY_REGION": ""
			},
			"secrets": { "required": ["BACKUP_KEY"] }
		}
	}
}
